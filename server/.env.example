# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
PORT=5000
NODE_ENV=development
# Local MongoDB:  mongodb://127.0.0.1:27017/fitbuddy
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitbuddy
MONGODB_URI=mongodb://127.0.0.1:27017/fitbuddy
# Any long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
# The address where the React app runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173
